# Copy to .env and fill in values

# Path to your master resume (DOCX)
MASTER_RESUME_PATH=C:\Users\Admin\Desktop\Jobs Applied\master_resume.docx

# Where tailored resumes and exports are saved
JOBS_APPLIED_FOLDER=C:\Users\Admin\Desktop\Jobs Applied

# Gmail search query (customize for your job alerts)
# Example: from:(ziprecruiter OR indeedemail OR glassdoor OR dice OR lensa) is:unread
GMAIL_SEARCH_QUERY=from:(ziprecruiter.com OR indeed.com OR glassdoor.com OR dice.com OR lensa.com) newer_than:7d

# Optional: local LLM via Ollama (free) — leave blank to use rule-based matching first
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Minimum match score (0-100) before tailoring a resume
MIN_MATCH_SCORE=65
