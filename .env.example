# Copy to .env and fill in values. Never commit .env.

# Path to your master resume (DOCX). Keep this file outside the repo if it contains PII.
MASTER_RESUME_PATH=

# Where tailored resumes and application folders are saved
JOBS_APPLIED_FOLDER=

# Google OAuth desktop client secrets (download from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=./credentials.json

# Token written after first OAuth consent (auto-created; keep private)
GMAIL_TOKEN_PATH=./token.json

# Gmail search for job-alert senders (read-only scope)
GMAIL_SEARCH_QUERY=from:(ziprecruiter.com OR indeed.com OR glassdoor.com OR dice.com OR lensa.com OR indeedemail.com) newer_than:14d

# Optional Gmail label filter (leave blank to ignore)
GMAIL_LABEL=

# Outlook / Hotmail IMAP (optional — use a Microsoft app password)
# Never put real credentials in this file. Rotate any password that was previously committed.
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=your.email@example.com
IMAP_PASSWORD=your-app-password-here
IMAP_FOLDER=INBOX

# Web Console local API token (required for admin/DB/CLI endpoints).
# Leave blank to auto-generate into data/web_console_token (gitignored) on first web start.
WEB_CONSOLE_TOKEN=

# Minimum match score (0-100) for "worth reviewing" default listing filters
MIN_MATCH_SCORE=65

# Optional LLM provider — leave blank/disabled for rule-based fallback
LLM_PROVIDER=none
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional paid/cloud LLM keys (only if you explicitly enable a provider)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# SQLite database path
DATABASE_PATH=./data/jobs.db

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
